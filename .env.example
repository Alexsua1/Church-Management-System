# Copy this file to .env and fill in your real values.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Set to True to use SQLite instead of PostgreSQL (quick local testing on Windows)
USE_SQLITE=True

# PostgreSQL settings (used when USE_SQLITE=False)
DB_NAME=church_management_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Firebase Storage (optional cloud storage for photos/receipts/backups)
USE_FIREBASE_STORAGE=False
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# SMS / WhatsApp notification providers
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=

# Online payments (Paystack works well for GHS)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
